{
  "name": "jev-spec",
  "version": "0.3.0",
  "description": "Catch spec drift on every commit: check your code against your Markdown specs with TypeSafe AI's Jev model.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jev-spec": "./bin/jev-spec.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomi-koborinai/jev-spec.git"
  },
  "bugs": {
    "url": "https://github.com/nozomi-koborinai/jev-spec/issues"
  },
  "homepage": "https://github.com/nozomi-koborinai/jev-spec#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test 'dist-test/test/**/*.test.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "probes": "npm run build && node scripts/run-probes.mjs"
  },
  "keywords": [
    "typesafe-ai",
    "jev",
    "sdd",
    "specification-driven-development",
    "spec-drift",
    "semantic-verification",
    "linter"
  ],
  "author": "Nozomi Koborinai",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nozomi-koborinai"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@typesafe-ai/sdk": "^0.6.0",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromatch": "^4.0.8"
  }
}
